{
  "name": "@sean0x42/koi",
  "version": "0.1.0",
  "description": "Components from the koi design system",
  "repository": "git+https://github.com/sean0x42/koi.git",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./base.css": {
      "import": "./dist/base.css"
    },
    "./reset.css": {
      "import": "./dist/reset.css"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./prose": {
      "types": "./dist/prose/index.d.ts",
      "import": "./dist/prose/index.js"
    }
  },
  "scripts": {
    "build:tcm": "tcm -a -p '**/*.module.css' src",
    "dev": "concurrently -k \"tsc --watch\" \"npm run build:tcm -- -w\" \"node copy-css.mjs --watch\"",
    "build": "npm run build:tcm && tsc && node copy-css.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "chokidar": "^3.6.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
